<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #FFF8EF;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.foundtime.SignupController">
    <padding>
        <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 0 0 15 20;" stylesheets="@styles.css" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="50.0">
        <Label fx:id="titleLabel" text="FoundTime" textFill="#383838">
            <font>
                <Font name="HeadlandOne" size="40.0" />
            </font>
        </Label>
    </HBox>

    <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 0 0 15 20;" stylesheets="@styles.css" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="100.0">
        <Label fx:id="singUpLabel" text="Create Account" textFill="#383838">
            <font>
                <Font name="HeadlandOne" size="20.0" />
            </font>
        </Label>
    </HBox>


    <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 0 0 15 20;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="135.0" AnchorPane.topAnchor="132.0">
        <Label fx:id="userLabel" text="Username">
            <font>
                <Font name="HeadlandOne" size="12.0" />
            </font>
        </Label>
    </HBox>

    <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 0 0 15 20;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="150.0">
        <TextField fx:id="username" prefWidth="200.0" />
    </HBox>


    <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 0 0 15 20;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="135.0" AnchorPane.topAnchor="185.0">
        <Label fx:id="passLabel" text="Password">
            <font>
                <Font name="HeadlandOne" size="12.0" />
            </font>
        </Label>
    </HBox>

    <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 0 0 15 20;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="203.0">
        <PasswordField fx:id="password" prefWidth="200.0" />
    </HBox>


    <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 0 0 15 20;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="80.0" AnchorPane.topAnchor="238.0">
        <Label fx:id="passConfirmLabel" text="Confirm Password">
            <font>
                <Font name="HeadlandOne" size="12.0" />
            </font>
        </Label>
    </HBox>

    <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 0 0 15 20;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="256.0">
        <PasswordField fx:id="passwordConfirm" prefWidth="200.0" />
    </HBox>


    <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 0 0 15 20;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="300.0">
        <Button onAction="#handleSignUpButton" prefWidth="100.0" text="Sign Up" style="-fx-background-color: #FFB3D4;-fx-background-radius: 15px;">
            <font>
                <Font name="HeadlandOne-Regular" size="14.0" />
            </font>
        </Button>
    </HBox>


    <HBox alignment="CENTER" spacing="1.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="345.0">
        <Label text="Already have an account?" >
            <font>
                <Font name="HeadlandOne-Regular" size="11.0"/>
            </font>
        </Label>
        <Hyperlink onAction="#handleLoginLink" text="Login" >
            <font>
                <Font name="HeadlandOne-Regular" size="11.0"/>
            </font>
        </Hyperlink>
    </HBox>


    <HBox alignment="CENTER" spacing="25.0" style="-fx-padding: 0 0 15 20;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="280.0">
        <Label fx:id="errorLabel" text="" textFill="#383838">
            <font>
                <Font size="12.0" />
            </font>
        </Label>
    </HBox>
</AnchorPane>
