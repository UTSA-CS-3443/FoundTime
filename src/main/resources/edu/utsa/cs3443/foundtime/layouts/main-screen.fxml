<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #FFF8EF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.foundtime.MainScreenController">
     <GridPane fx:id="calendarGrid" gridLinesVisible="true" layoutX="7.0" layoutY="109.0" maxHeight="1000" maxWidth="1000" prefHeight="265.0" prefWidth="586.0">
         <padding>
             <Insets bottom="20.0" left="20.0" right="20.0" top="0.0" />
         </padding>

                              <!-- 7 Equal Columns for Days of the Week -->
         <columnConstraints>
             <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
             <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
             <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
             <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
             <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
             <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
             <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
