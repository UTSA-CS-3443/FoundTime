                    <VBox alignment="CENTER" prefWidth="100.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFB3D4; -fx-padding: 6;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="SAT"/>
                        <Label text="28" fx:id="saturday"/>
                    </VBox>
                </HBox>
            </VBox>
