<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="450.0" prefWidth="800.0" style="-fx-background-color: #FFF8EF;"
            xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
            fx:controller="edu.utsa.cs3443.foundtime.WeekScreenController">

    <BorderPane AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0"
                AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">

        <top>
            <VBox spacing="8.0" BorderPane.alignment="CENTER">
                <BorderPane.margin>
                    <Insets bottom="4.0"/>
                </BorderPane.margin>

                <HBox alignment="CENTER" prefHeight="36.0">
                    <Region prefWidth="65.0"/>
                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER" spacing="16.0">
                        <Button mnemonicParsing="false" text="←" onAction="#handleBackButton"/>
                        <Label alignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 14px;"
                               text="November 22 - November 28, 2026"/>
                        <Button mnemonicParsing="false" text="→" onAction="#handleForwardButton"/>
                        <Button mnemonicParsing="false" prefWidth="65.0" text="Today"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER_RIGHT" prefWidth="115.0" spacing="6.0">
                        <Button mnemonicParsing="false" text="Month" onAction="#handleMonthButton"/>
                        <Button mnemonicParsing="false" text="Day" onAction="#handleDayButton"/>
                    </HBox>
                </HBox>

                <HBox alignment="CENTER" prefHeight="48.0" style="-fx-padding: 0 14 0 0;">
                    <VBox maxWidth="60.0" minWidth="60.0" prefWidth="60.0"/>

                    <VBox alignment="CENTER" prefWidth="100.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFB3D4; -fx-border-color: #cc6c96; -fx-border-width: 0 1 0 0; -fx-padding: 6;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="SUN"/>
                        <Label text="22" fx:id="sunday"/>
                    </VBox>

                    <VBox alignment="CENTER" prefWidth="100.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFB3D4; -fx-border-color: #cc6c96; -fx-border-width: 0 1 0 0; -fx-padding: 6;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="MON"/>
                        <Label text="23" fx:id="monday"/>
                    </VBox>

                    <VBox alignment="CENTER" prefWidth="100.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFB3D4; -fx-border-color: #cc6c96; -fx-border-width: 0 1 0 0; -fx-padding: 6;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="TUE"/>
                        <Label text="24" fx:id="tuesday"/>
                    </VBox>

                    <VBox alignment="CENTER" prefWidth="100.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFB3D4; -fx-border-color: #cc6c96; -fx-border-width: 0 1 0 0; -fx-padding: 6;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="WED"/>
                        <Label text="25" fx:id="wednesday"/>
                    </VBox>

                    <VBox alignment="CENTER" prefWidth="100.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFB3D4; -fx-border-color: #cc6c96; -fx-border-width: 0 1 0 0; -fx-padding: 6;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="THU"/>
                        <Label text="26" fx:id="thursday"/>
                    </VBox>

                    <VBox alignment="CENTER" prefWidth="100.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFB3D4; -fx-border-color: #cc6c96; -fx-border-width: 0 1 0 0; -fx-padding: 6;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="FRI"/>
