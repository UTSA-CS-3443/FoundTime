<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #FFF8EF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.foundtime.WeekScreenController">

    <!-- The same as the main/month screen, but idk if we should do something else...-->
    <HBox alignment="CENTER" spacing="25.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="50.0">
        <GridPane fx:id="calendarGrid" gridLinesVisible="true" maxHeight="1000" maxWidth="1000" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="0.0" />
            </padding>

            <!-- 7 Equal Columns for Days of the Week -->
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
            </columnConstraints>

            <!-- Row 0: Fixed height for Day Headers; Rows 1-6: Equal height for Weeks -->
            <rowConstraints>
                <RowConstraints maxHeight="35.0" minHeight="35.0" prefHeight="35.0" vgrow="NEVER" />
                <RowConstraints maxHeight="35.0" minHeight="35.0" vgrow="ALWAYS" />
                <RowConstraints maxHeight="35.0" minHeight="35.0" vgrow="ALWAYS" />
                <RowConstraints maxHeight="35.0" minHeight="35.0" vgrow="ALWAYS" />
                <RowConstraints maxHeight="35.0" minHeight="35.0" vgrow="ALWAYS" />
                <RowConstraints maxHeight="35.0" minHeight="35.0" vgrow="ALWAYS" />
                <RowConstraints maxHeight="35.0" minHeight="35.0" vgrow="ALWAYS" />
            </rowConstraints>

            <!-- Day-of-Week Header Labels (Row 0) -->
            <children>
                <!--Row 1-->
                <Label style="-fx-font-weight: bold;" text="Sun" GridPane.columnIndex="0" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
                <Label style="-fx-font-weight: bold;" text="Mon" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
                <Label style="-fx-font-weight: bold;" text="Tue" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
                <Label style="-fx-font-weight: bold;" text="Wed" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
                <Label style="-fx-font-weight: bold;" text="Thu" GridPane.columnIndex="4" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
                <Label style="-fx-font-weight: bold;" text="Fri" GridPane.columnIndex="5" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
                <Label style="-fx-font-weight: bold;" text="Sat" GridPane.columnIndex="6" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
            </children>
            <children>
                <Label style="-fx-font-weight: bold;" text=" " GridPane.columnIndex="0" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
                <Label style="-fx-font-weight: bold;" text=" " GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
                <Label style="-fx-font-weight: bold;" text=" " GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
                <Label style="-fx-font-weight: bold;" text=" " GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.rowIndex="4" />
                <Label style="-fx-font-weight: bold;" text=" " GridPane.columnIndex="4" GridPane.halignment="CENTER" GridPane.rowIndex="5" />
            </children>
        </GridPane>
    </HBox>
   <Button layoutX="31.0" layoutY="14.0" mnemonicParsing="false" onAction="#onBackButtonClick" text="Back" />

</AnchorPane>
